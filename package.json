{
  "name": "@plagnito/soundmcp",
  "version": "2.4.0",
  "description": "Serveur MCP de composition instrumentale et de synthèse programmable : esquisses, sons personnels, retouches et exports WAV/MIDI.",
  "main": "src/index.js",
  "author": "Plagnito",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Plagnito/soundmcp.git"
  },
  "bugs": {
    "url": "https://github.com/Plagnito/soundmcp/issues"
  },
  "homepage": "https://github.com/Plagnito/soundmcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "music",
    "sfx",
    "sound-effects",
    "game-audio",
    "wav",
    "midi",
    "procedural-audio",
    "ai",
    "zero-dependency",
    "chiptune",
    "lofi"
  ],
  "files": [
    "src",
    "scripts",
    "banks/studio/*.json",
    "banks/studio/*.pcm.br",
    "banks/studio/CREDITS.md",
    "examples/godot-adaptive/*.{gd,godot,js,md,tscn}",
    "examples/web-audio-adaptive/*.{html,js,md,mjs}",
    "CHANGELOG.md",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node scripts/smoke.js && node scripts/quality.js && node scripts/studio.js && node scripts/workflow.js && node scripts/sound-design.js && node scripts/custom-synth.js && node scripts/production-workflows.js && node --test examples/web-audio-adaptive/player.test.mjs",
    "demo": "node src/cli.js music lofi --dur 24 --seed 7",
    "bench": "node scripts/listening-bench.js"
  },
  "bin": {
    "soundmcp": "src/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
